{
  "manifest_version": 3,
  "name": "Luma Features",
  "short_name": "Luma",
  "version": "0.3.1",
  "description": "Luma Home, quick access, local diagnostics, page-level media controls, opt-in phone remote and the Luma Cinema media engine. No telemetry.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Luma Features",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/bus.js",
        "content/capability.js",
        "content/bridge.js",
        "media/detector.js",
        "content/media-probe.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "*://challenges.cloudflare.com/*"
      ]
    }
  ]
}
